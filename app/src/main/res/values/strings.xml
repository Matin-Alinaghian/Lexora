    <!-- About dialog -->
    <string name="about_version">Version 1.0.0</string>
    <string name="about_creator">Created by Matin Alinaghian</string>
    <string name="about_desc">A professional English learning app with an offline bilingual dictionary, quick review, quizzes, and a beautiful modern design.</string>
    <string name="about_features">📦 Offline Dictionary — 300,000+ bilingual entries with phonetics\n🧠 Quick Review — Practice random words or a single list, any time\n🔑 Review Reminder — We notify you when words are ready to revisit\n📚 Vocabulary, Grammar &amp; Notes — Your full learning library\n❓ Quiz — Test yourself with 4-choice questions\n🔑 Mistakes — Re-practice the words you got wrong\n⭐ Favorites — Star and revisit your important words\n📊 Statistics — Streaks, accuracy breakdown and progress tracking\n🔔 Smart Reminders — Daily study plus timely review notifications\n🔊 Text-to-Speech &amp; Sound Effects — Pronunciation and interactive sounds\n🎨 Light &amp; Dark Themes — A clean, modern look</string>

